# Copy this file to .env and fill in your own values. .env is git-ignored.
# Generate secrets with:  openssl rand -base64 48

# MySQL (also used by the mysql container in compose.yaml)
GATEKEEPER_DB_PASSWORD=

# JWT signing key for the management service, at least 32 characters
GATEKEEPER_JWT_SECRET=

# Passwords for the accounts created on first start, at least 12 characters each
GATEKEEPER_PLATFORM_ADMIN_PASSWORD=
GATEKEEPER_GATEWAY_PASSWORD=
